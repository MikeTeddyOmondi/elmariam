{
  "name": "@elmariam/auth",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac.d.ts",
      "default": "./dist/rbac.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openauthjs/openauth": "0.4.3",
    "valibot": "1.4.0"
  },
  "peerDependencies": {
    "express": "4.22.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "typescript": "5.9.3"
  }
}
