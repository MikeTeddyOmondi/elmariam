<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>{{title}}</title></head>
<body style="font-family:system-ui,-apple-system,'Segoe UI',sans-serif;line-height:1.6;color:#1a1a2e;">
  <h2>{{title}}</h2>
  <table cellpadding="6" style="border-collapse:collapse;margin-bottom:1rem;">
    <tr>
      <td style="color:#666;">From</td>
      <td><strong>{{name}}</strong></td>
    </tr>
    <tr>
      <td style="color:#666;">Email</td>
      <td><a href="mailto:{{email}}">{{email}}</a></td>
    </tr>
  </table>
  <p style="color:#666;margin-bottom:0.25rem;">Message</p>
  <blockquote style="margin:0;padding:0.75rem 1rem;border-left:3px solid #ddd;background:#fafafa;white-space:pre-wrap;">{{message}}</blockquote>
  <p style="color:#999;font-size:0.85rem;margin-top:1.5rem;">
    Sent from the El'Mariam website contact form.
  </p>
</body>
</html>
