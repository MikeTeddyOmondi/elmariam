# ──── MongoDB ────
MONGODB_URL=mongodb://mongo:27017/elmariam

# ──── RabbitMQ ────
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_DEFAULT_VHOST=elmariam

# ──── IntaSend (Checkout Service) ────
INTASEND_API_TOKEN=ISSecretKey_test_...
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_...
INTASEND_TEST_MODE=true

# ──── UjumbeSMS (SMS Service) ────
UJUMBESMS_API_KEY=your_ujumbesms_api_key
UJUMBESMS_API_URL=https://ujumbesms.co.ke
UJUMBESMS_ACCOUNT_EMAIL=your@email.com

# ──── Gmail OAuth2 (SMTP Service) ────
EMAIL_SENDER=your@gmail.com
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_ACCESS_TOKEN=your_gmail_access_token

# ──── OpenAuth ────
OPENAUTH_ISSUER=https://auth.otienoobogeandcompany.com
